# ============================================================
# Istiqo — Quran Foundation (Hackathon)
# ============================================================
#
# PAKAI PRE-PRODUCTION untuk development + User API + Activity API:
#   OAuth:   https://prelive-oauth2.quran.foundation
#   Content: https://apis-prelive.quran.foundation
#   Auth API: https://apis-prelive.quran.foundation/auth
#
# PRODUCTION = konten penuh, TAPI user/auth TIDAK aktif kecuali disetujui panitia.
# Jangan pakai production key untuk login / activity-days saat hackathon.
#
# REKOMENDASI SPLIT ENV (konten penuh + Activity API hackathon):
#   QF_CONTENT_ENV=production   → semua surat / recitation
#   QF_USER_ENV=prelive         → activity-days (wajib prelive untuk hackathon)
#   QF_CLIENT_ID/SECRET       → kredensial Pre-Production (user + oauth)
#   QF_CONTENT_CLIENT_ID/SECRET → kredensial Production (content saja)
#
# Salin file ini ke .env lalu isi dari email panitia.
# ============================================================

# ── Environment ─────────────────────────────────────────────────────────────
QF_ENV=prelive
QF_CONTENT_ENV=production
QF_USER_ENV=prelive

# ── Pre-Production credentials (User API, OAuth, demo token) ────────────────
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# ── Production credentials (Content API saja, jika QF_CONTENT_ENV=production)
QF_CONTENT_CLIENT_ID=
QF_CONTENT_CLIENT_SECRET=

# ── QF OAuth login (tombol hijau di app) ────────────────────────────────────
# WAJIB exact match dengan yang didaftarkan panitia QF (localhost ≠ 127.0.0.1).
# Coba salah satu jika login hijau error "redirect_uri":
#   http://localhost:5173/api/auth/qf/callback  (via Vite proxy → backend)
#   http://localhost:3001/api/auth/qf/callback  (langsung ke Express)
# Email Hackathon@quran.com + Client ID Pre-Production Anda untuk mendaftarkan URI.
QF_REDIRECT_URI=http://localhost:5173/api/auth/qf/callback
FRONTEND_URL=http://localhost:5173
QF_OAUTH_SCOPES=openid offline_access activity_day user

# ── Demo juri (opsional, hackathon shortcut) ────────────────────────────────
# 1. Login di PRELIVE: https://prelive-oauth2.quran.foundation (BUKAN oauth2.quran.foundation)
# 2. DevTools Network → request ke apis-prelive.../activity-days → salin x-auth-token
# 3. Tempel di sini (JANGAN commit .env ke git). Token biasanya kedaluwarsa ~1 jam.
# 4. Di app: tombol "Mode Demo Juri" → Activity API langsung jalan tanpa OAuth juri
QF_DEMO_ACCESS_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────
API_PORT=3001
NODE_ENV=development

# ── Google Sign-In (opsional, bukan untuk Activity API) ─────────────────────
VITE_GOOGLE_CLIENT_ID=
