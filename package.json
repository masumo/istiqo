{
  "name": "istiqo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:server": "nodemon --watch server server/index.js",
    "dev:all": "concurrently \"vite\" \"nodemon --watch server server/index.js\" --names \"vite,api\" --prefix-colors \"cyan,green\"",
    "build": "vite build",
